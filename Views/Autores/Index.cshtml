@model List<FeriaDelLibro.Models.Autor>
@{
    ViewData["Title"] = "Autores";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>✍️ Autores</h1>
    <a asp-action="Crear" class="btn btn-primary">+ Nuevo autor</a>
</div>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Mensaje"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>Nombre</th>
            <th>País</th>
            <th>Libros</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var autor in Model)
        {
            <tr>
                <td>@autor.Nombre</td>
                <td>@autor.Pais</td>
                <td><span class="badge bg-secondary">@autor.Libros.Count</span></td>
                <td class="text-end">
                    <a asp-action="Editar" asp-route-id="@autor.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                    <a asp-action="Eliminar" asp-route-id="@autor.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>