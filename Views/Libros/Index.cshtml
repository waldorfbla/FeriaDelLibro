@model List<FeriaDelLibro.Models.Libro>
@{
    ViewData["Title"] = "Catálogo";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>🌸 Feria del Libro</h1>
    <a asp-action="Crear" class="btn btn-primary">+ Registrar libro</a>
</div>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Mensaje"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>Título</th>
            <th>Autor</th>
            <th>Género</th>
            <th>Precio</th>
            <th>Stock</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var libro in Model)
        {
            <tr>
                <td>@libro.Titulo</td>
                <td>@libro.Autor</td>
                <td><span class="badge bg-secondary">@libro.Genero</span></td>
                <td>@libro.Precio.ToString("C0")</td>
                <td>
                    @if (libro.Stock > 0)
                    {
                        <span class="badge bg-success">@libro.Stock</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Agotado</span>
                    }
                </td>
                <td class="text-end">
                    @if (libro.Stock > 0)
                    {
                        <a asp-action="Reservar" asp-route-id="@libro.Id" class="btn btn-sm btn-outline-primary">Reservar</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
